[Unit]
Description=Oracle DBA AI Operations Portal (Next.js)
After=network.target oracle.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/data1/oracle_dba_app/oracle_dba_app_v7.3
EnvironmentFile=/data1/oracle_dba_app/oracle_dba_app_v7.3/.env.local
Environment=NODE_ENV=production
Environment=HOSTNAME=0.0.0.0
Environment=PORT=3001
Environment=NODE_OPTIONS=--max-old-space-size=1024
ExecStart=/usr/bin/npm run start
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=oracle-dba-portal

# Hardening (adjust if your Node/npm path differs)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
